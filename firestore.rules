rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{userId} {

      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == userId;

      allow update: if signedIn()
        && request.auth.uid == userId;

      allow delete: if false;
    }

    match /resources/{resourceId} {

      // Approved resources are publicly readable.
      // Administrators can read everything.
      // Users can read resources they submitted.
      allow read: if resource.data.status == "approved"
        || isAdmin()
        || (signedIn() && resource.data.submittedByUid == request.auth.uid);

      // A signed-in user can create a resource belonging to themselves.
      allow create: if signedIn()
        && request.resource.data.submittedByUid == request.auth.uid
        && (
          request.resource.data.status == "pending"
          || isAdmin()
        );

      // Administrators can modify resources.
      //
      // Everyone else, including anonymous visitors, can ONLY
      // increase downloadCount by exactly 1 on an approved resource.
      allow update: if isAdmin()
        || (
          resource.data.status == "approved"
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['downloadCount'])
          && (
            (
              resource.data.keys().hasAll(['downloadCount'])
              && request.resource.data.downloadCount
                 == resource.data.downloadCount + 1
            )
            ||
            (
              !resource.data.keys().hasAll(['downloadCount'])
              && request.resource.data.downloadCount == 1
            )
          )
        );

      allow delete: if isAdmin();
    }
  }
}
