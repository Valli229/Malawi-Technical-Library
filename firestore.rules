rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /resources/{resourceId} {
      allow read: if resource.data.status == "approved"
        || isAdmin()
        || (signedIn() && resource.data.submittedByUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.submittedByUid == request.auth.uid
        && (request.resource.data.status == "pending" || isAdmin());

      // Administrators may update any fields. Non-admins (signed or anonymous)
      // are only allowed to increment the `downloadCount` field on publicly
      // visible (approved) resources. The rules validate that the only
      // affected key is `downloadCount` and that the new value is exactly
      // one greater than the previous value (or 1 when previously absent).
      allow update: if isAdmin() || (
        resource.data.status == "approved"
        // Either the client sends a regular update where the new document
        // snapshot is available for inspection (validate +1), OR the write
        // is a transform-only write (e.g. an atomic `increment`) in which
        // case `request.writeFields()` will list the affected fields.
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount'])
            && (
              (resource.data.downloadCount != null && request.resource.data.downloadCount == resource.data.downloadCount + 1)
              || (resource.data.downloadCount == null && request.resource.data.downloadCount == 1)
            )
          )
          || request.writeFields().hasOnly(['downloadCount'])
        )
      );

      allow delete: if isAdmin();
    }
  }
}
